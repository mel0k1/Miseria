<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miseria.App.ViewModels"
             x:Class="Miseria.App.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">
    <UserControl.Styles>
        <Style Selector="Ellipse.online">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.away">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
        <Style Selector="Ellipse.ingame">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}" />
        </Style>
        <Style Selector="Ellipse.offline">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorDisabledBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*"
          RowSpacing="16"
          Margin="28,24,28,16">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,280"
              ColumnSpacing="16">
            <StackPanel Spacing="2">
                <TextBlock Text="Друзья"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Статусы обновляются в реальном времени"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText}"
                     PlaceholderText="Поиск друзей"
                     VerticalAlignment="Center" />
        </Grid>
        <Panel Grid.Row="1">
            <ListBox ItemsSource="{Binding Visible}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="52,*"
                              ColumnSpacing="12"
                              Margin="0,6">
                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Panel>
                                    <Image Source="{Binding Avatar}"
                                           IsVisible="{Binding HasAvatar}"
                                           Stretch="UniformToFill" />
                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            IsVisible="{Binding !HasAvatar}">
                                        <TextBlock Text="{Binding Initial}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Classes.online="{Binding IsOnline}"
                                             Classes.away="{Binding IsAway}"
                                             Classes.ingame="{Binding IsInGame}"
                                             Classes.offline="{Binding IsOffline}" />
                                    <TextBlock Text="{Binding PresenceText}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasList}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="2" />
                <TextBlock Text="Получение списка друзей…"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding HasList}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel IsVisible="{Binding !HasFriends}">
                    <TextBlock IsVisible="{Binding SearchActive}"
                               Text="Никого не найдено"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock IsVisible="{Binding !SearchActive}"
                               Text="В списке друзей пока никого нет"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
