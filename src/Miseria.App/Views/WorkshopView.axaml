<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miseria.App.ViewModels"
             x:Class="Miseria.App.Views.WorkshopView"
             x:DataType="vm:WorkshopViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.cardLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.itemRow">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.itemRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.segmented">
            <Setter Property="Padding" Value="12,5" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12"
          Margin="28,24,28,16">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,180"
              ColumnSpacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="Мастерская"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Apps}"
                      SelectedItem="{Binding SelectedApp}"
                      DisplayMemberBinding="{Binding Name}"
                      VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
            <TextBox x:Name="SearchInput"
                     Text="{Binding SearchText}"
                     PlaceholderText="Поиск в мастерской"
                     KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1"
                    Content="Найти"
                    Command="{Binding SearchCommand}"
                    VerticalAlignment="Stretch" />
        </Grid>
        <Grid Grid.Row="2"
              ColumnDefinitions="*,330"
              ColumnSpacing="16">
            <ScrollViewer Grid.Column="0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes.itemRow="True"
                                        Tapped="OnItemTapped">
                                    <Grid ColumnDefinitions="96,*,Auto"
                                          ColumnSpacing="10">
                                        <Border Width="96"
                                                Height="54"
                                                CornerRadius="4"
                                                ClipToBounds="True">
                                            <Panel>
                                                <Image Source="{Binding Icon}"
                                                       IsVisible="{Binding HasIcon}"
                                                       Stretch="UniformToFill" />
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        IsVisible="{Binding !HasIcon}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Text="{Binding CreatorText}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding StatsText}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   IsVisible="{Binding HasSize}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Показать ещё"
                            Command="{Binding LoadMoreCommand}"
                            IsEnabled="{Binding HasMore}"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            IsVisible="{Binding HasItems}" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    VerticalAlignment="Top"
                    IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding SelectedItem.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedItem.CreatorText}"
                               Classes.cardLabel="True" />
                    <Border Height="150"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Image Source="{Binding SelectedItem.Icon}"
                               IsVisible="{Binding SelectedItem.HasIcon}"
                               Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding SelectedItem.StatsText}"
                               Classes.cardLabel="True" />
                    <TextBlock Text="{Binding SelectedItem.UpdatedText}"
                               Classes.cardLabel="True"
                               IsVisible="{Binding SelectedItem.HasUpdated}" />
                    <TextBlock Text="{Binding SelectedItem.TagsText}"
                               Classes.cardLabel="True"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SelectedItem.HasTags}" />
                    <TextBlock Text="{Binding SelectedItem.Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MaxHeight="150"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding SelectedItem.HasDescription}" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Подписаться"
                                Command="{Binding SubscribeCommand}"
                                CommandParameter="{Binding SelectedItem}"
                                IsEnabled="{Binding !SelectedItem.IsBusy}"
                                Margin="0,0,8,8" />
                        <Button Content="Отписаться"
                                Command="{Binding UnsubscribeCommand}"
                                CommandParameter="{Binding SelectedItem}"
                                IsEnabled="{Binding !SelectedItem.IsBusy}"
                                Margin="0,0,8,8" />
                        <HyperlinkButton Content="Открыть в Steam"
                                         NavigateUri="{Binding SelectedItem.DetailsUrl}"
                                         Padding="0"
                                         VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ActionMessage}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2"
                    IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center"
                    Margin="0,48,0,0"
                    Spacing="8">
            <TextBlock Text="Ничего не найдено"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Измените запрос или выберите другую игру."
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="2"
              IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="2" />
                <TextBlock Text="Загрузка мастерской…"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
