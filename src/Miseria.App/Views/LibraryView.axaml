<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Miseria.App.ViewModels"
             x:Class="Miseria.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="16"
          Margin="28,24,28,16">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,280"
              ColumnSpacing="16">
            <StackPanel Spacing="2">
                <TextBlock Text="Библиотека"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding CountText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding LaunchMessage}"
                           IsVisible="{Binding LaunchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText}"
                     PlaceholderText="Поиск в библиотеке"
                     VerticalAlignment="Center" />
        </Grid>
        <Panel Grid.Row="1">
            <ListBox ItemsSource="{Binding Visible}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="44,*,Auto"
                              ColumnSpacing="12"
                              Margin="0,4">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Panel>
                                    <Image Source="{Binding Icon}"
                                           IsVisible="{Binding HasIcon}"
                                           Stretch="UniformToFill" />
                                    <TextBlock IsVisible="{Binding !HasIcon}"
                                               Text="{Binding Initial}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TypeText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <Button IsVisible="{Binding IsInstalled}"
                                        Padding="12,6"
                                        Classes="accent"
                                        ToolTip.Tip="Запустить установленную игру"
                                        Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Play"
                                                         FontSize="14" />
                                        <TextBlock Text="Играть" />
                                    </StackPanel>
                                </Button>
                                <Button IsVisible="{Binding !IsInstalled}"
                                        VerticalAlignment="Center"
                                        Padding="8"
                                        ToolTip.Tip="Скачать через Steam CDN"
                                        Command="{Binding $parent[UserControl].DataContext.Download.StartCommand}"
                                        CommandParameter="{Binding}">
                                    <ui:FASymbolIcon Symbol="Download"
                                                     FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasList}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="2" />
                <TextBlock Text="Получение библиотеки…"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding HasList}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel IsVisible="{Binding !HasApps}">
                    <TextBlock IsVisible="{Binding SearchActive}"
                               Text="Ничего не найдено"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock IsVisible="{Binding !SearchActive}"
                               Text="В библиотеке пока пусто"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
