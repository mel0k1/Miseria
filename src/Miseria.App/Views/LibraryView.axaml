<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Miseria.App.ViewModels"
             x:Class="Miseria.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="16"
          Margin="28,24,28,16">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,280"
              ColumnSpacing="16">
            <StackPanel Spacing="2">
                <TextBlock Text="Библиотека"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding CountText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding LaunchMessage}"
                           IsVisible="{Binding LaunchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Padding="8"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleViewCommand}">
                <Panel>
                    <ui:FASymbolIcon Symbol="SetTile"
                                     FontSize="16"
                                     IsVisible="{Binding !IsGrid}" />
                    <ui:FASymbolIcon Symbol="List"
                                     FontSize="16"
                                     IsVisible="{Binding IsGrid}" />
                </Panel>
            </Button>
            <TextBox Grid.Column="2"
                     Text="{Binding SearchText}"
                     PlaceholderText="Поиск в библиотеке"
                     VerticalAlignment="Center" />
        </Grid>
        <Panel Grid.Row="1">
            <ListBox ItemsSource="{Binding Visible}"
                     IsVisible="{Binding !IsGrid}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="44,*,Auto"
                              ColumnSpacing="12"
                              Margin="0,4">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Panel>
                                    <Image Source="{Binding Icon}"
                                           IsVisible="{Binding HasIcon}"
                                           Stretch="UniformToFill" />
                                    <TextBlock IsVisible="{Binding !HasIcon}"
                                               Text="{Binding Initial}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TypeText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <Button IsVisible="{Binding IsInstalled}"
                                        Padding="12,6"
                                        Classes="accent"
                                        ToolTip.Tip="Запустить установленную игру"
                                        Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Play"
                                                         FontSize="14" />
                                        <TextBlock Text="Играть" />
                                    </StackPanel>
                                </Button>
                                <Button IsVisible="{Binding !IsInstalled}"
                                        VerticalAlignment="Center"
                                        Padding="8"
                                        ToolTip.Tip="Скачать через Steam CDN"
                                        Command="{Binding $parent[UserControl].DataContext.Download.StartCommand}"
                                        CommandParameter="{Binding}">
                                    <ui:FASymbolIcon Symbol="Download"
                                                     FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer IsVisible="{Binding IsGrid}">
                <ItemsControl ItemsSource="{Binding Visible}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="231"
                                        Margin="0,0,12,14"
                                        Spacing="6">
                                <Panel>
                                    <Border Height="87"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Panel>
                                            <Image Source="{Binding Capsule}"
                                                   IsVisible="{Binding HasCapsule}"
                                                   Stretch="UniformToFill" />
                                            <TextBlock IsVisible="{Binding !HasCapsule}"
                                                       Text="{Binding Initial}"
                                                       FontSize="26"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Panel>
                                    </Border>
                                    <Button IsVisible="{Binding IsInstalled}"
                                            Classes="accent"
                                            Padding="8,4"
                                            Margin="0,0,6,6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            ToolTip.Tip="Запустить установленную игру"
                                            Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ui:FASymbolIcon Symbol="Play"
                                                             FontSize="12" />
                                            <TextBlock Text="Играть" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button IsVisible="{Binding !IsInstalled}"
                                            Classes="accent"
                                            Padding="6"
                                            Margin="0,0,6,6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            ToolTip.Tip="Скачать через Steam CDN"
                                            Command="{Binding $parent[UserControl].DataContext.Download.StartCommand}"
                                            CommandParameter="{Binding}">
                                        <ui:FASymbolIcon Symbol="Download"
                                                         FontSize="14" />
                                    </Button>
                                </Panel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel IsVisible="{Binding !HasList}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="2" />
                <TextBlock Text="Получение библиотеки…"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding HasList}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel IsVisible="{Binding !HasApps}">
                    <TextBlock IsVisible="{Binding SearchActive}"
                               Text="Ничего не найдено"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock IsVisible="{Binding !SearchActive}"
                               Text="В библиотеке пока пусто"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
