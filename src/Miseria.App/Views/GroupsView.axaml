<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miseria.App.ViewModels"
             x:Class="Miseria.App.Views.GroupsView"
             x:DataType="vm:GroupsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.cardLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.itemRow">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.itemRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12"
          Margin="28,24,28,16">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="Группы"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
            <TextBox x:Name="JoinInput"
                     Text="{Binding JoinQuery}"
                     PlaceholderText="Короткое имя группы или ссылка, например valvesoftware" />
            <Button Grid.Column="1"
                    Content="Найти"
                    Command="{Binding FindCommand}"
                    VerticalAlignment="Stretch" />
        </Grid>
        <Grid Grid.Row="2"
              ColumnDefinitions="*,330"
              ColumnSpacing="16">
            <ScrollViewer Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="Мои группы"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes.itemRow="True"
                                        Tapped="OnItemTapped">
                                    <Grid ColumnDefinitions="40,*,Auto"
                                          ColumnSpacing="10">
                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="4"
                                                ClipToBounds="True">
                                            <Panel>
                                                <Image Source="{Binding Avatar}"
                                                       IsVisible="{Binding HasAvatar}"
                                                       Stretch="UniformToFill" />
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        IsVisible="{Binding !HasAvatar}">
                                                    <TextBlock Text="?"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Name}" />
                                            <TextBlock Text="{Binding CountText}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Content="Вступить"
                                                    Command="{Binding $parent[UserControl].DataContext.JoinCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Padding="10,4" />
                                            <Button Content="Покинуть"
                                                    Command="{Binding $parent[UserControl].DataContext.LeaveCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Padding="10,4" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    VerticalAlignment="Top"
                    IsVisible="{Binding SelectedGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding SelectedGroup.Name}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <Border Width="120"
                            Height="120"
                            CornerRadius="6"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            ClipToBounds="True">
                        <Image Source="{Binding SelectedGroup.Avatar}"
                               IsVisible="{Binding SelectedGroup.HasAvatar}"
                               Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding SelectedGroup.Headline}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SelectedGroup.HasHeadline}" />
                    <TextBlock Text="{Binding SelectedGroup.CountText}"
                               Classes.cardLabel="True" />
                    <TextBlock Text="{Binding SelectedGroup.Summary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MaxHeight="180"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding SelectedGroup.HasSummary}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="Вступить"
                                Command="{Binding JoinCommand}"
                                CommandParameter="{Binding SelectedGroup}"
                                IsEnabled="{Binding !SelectedGroup.IsBusy}" />
                        <Button Content="Покинуть"
                                Command="{Binding LeaveCommand}"
                                CommandParameter="{Binding SelectedGroup}"
                                IsEnabled="{Binding !SelectedGroup.IsBusy}" />
                        <HyperlinkButton Content="Открыть в Steam"
                                         NavigateUri="{Binding SelectedGroup.GroupUrl}"
                                         Padding="0"
                                         IsVisible="{Binding SelectedGroup.HasLink}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActionMessage}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2"
                    IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center"
                    Margin="0,48,0,0"
                    Spacing="8">
            <TextBlock Text="Групп пока нет"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Найдите группу по короткому имени или ссылке, чтобы вступить в неё."
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="2"
              IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="2" />
                <TextBlock Text="Загрузка групп…"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
