<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Miseria.App.ViewModels"
             x:Class="Miseria.App.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <UserControl.Styles>
        <Style Selector="Ellipse.online">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.away">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
        <Style Selector="Ellipse.ingame">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}" />
        </Style>
        <Style Selector="Ellipse.offline">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorDisabledBrush}" />
        </Style>
        <Style Selector="TextBlock.rowLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="36,32"
                    Spacing="16"
                    MaxWidth="640"
                    HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding TitleText}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Content="Мой профиль"
                        Command="{Binding BackToOwnCommand}"
                        IsVisible="{Binding HasBack}"
                        VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding StatusText}"
                       IsVisible="{Binding HasStatus}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="18">
                        <Border Width="88"
                                Height="88"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Panel>
                                <Image Source="{Binding Avatar}"
                                       IsVisible="{Binding HasAvatar}"
                                       Stretch="UniformToFill" />
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        IsVisible="{Binding !HasAvatar}">
                                    <TextBlock Text="{Binding Initial}"
                                               FontSize="34"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <Ellipse Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Classes.online="{Binding IsOnline}"
                                         Classes.away="{Binding IsAway}"
                                         Classes.ingame="{Binding IsInGame}"
                                         Classes.offline="{Binding IsOffline}" />
                                <TextBlock Text="{Binding PresenceText}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding AccountName}"
                                       IsVisible="{Binding HasAccountName}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SteamIdText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Panel>
                    <StackPanel IsVisible="{Binding ExtrasBusy}"
                                Spacing="10">
                        <ProgressBar IsIndeterminate="True"
                                     Width="220"
                                     Height="2" />
                        <TextBlock Text="Загрузка данных профиля…"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid IsVisible="{Binding !ExtrasBusy}">
                        <TextBlock IsVisible="{Binding IsPrivate}"
                                   Text="Профиль скрыт настройками приватности"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid IsVisible="{Binding !IsPrivate}"
                              ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <Border Background="{DynamicResource SystemFillColorSuccessBrush}"
                                        CornerRadius="10"
                                        Padding="12,4"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding HasLevel}">
                                    <TextBlock Text="{Binding LevelText}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="—"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding !HasLevel}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Уровень"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="{Binding GamesCountText}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Игр"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="{Binding TotalHoursText}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Часов в играх"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Panel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    IsVisible="{Binding HasGames}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Часто играемые"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding TopGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileGameRow">
                                <Grid ColumnDefinitions="*,Auto"
                                      Margin="0,4">
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding HoursText}"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    IsVisible="{Binding HasScreenshots}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Скриншоты"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Screenshots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileScreenshotRow">
                                <HyperlinkButton NavigateUri="{Binding DetailsUrl}"
                                                 Margin="0,0,8,8"
                                                 Padding="0">
                                    <Border Width="148"
                                            Height="83"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Image Source="{Binding Image}"
                                               IsVisible="{Binding HasImage}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2"
                                IsVisible="{Binding HasRealName}">
                        <TextBlock Classes.rowLabel="True" Text="Настоящее имя" />
                        <TextBlock Text="{Binding RealName}" />
                    </StackPanel>
                    <StackPanel Spacing="2"
                                IsVisible="{Binding HasCountry}">
                        <TextBlock Classes.rowLabel="True" Text="{Binding CountryLabel}" />
                        <TextBlock Text="{Binding Country}" />
                    </StackPanel>
                    <StackPanel Spacing="2"
                                IsVisible="{Binding HasMemberSince}">
                        <TextBlock Classes.rowLabel="True" Text="В Steam с" />
                        <TextBlock Text="{Binding MemberSinceText}" />
                    </StackPanel>
                    <HyperlinkButton Content="Открыть профиль в Steam"
                                     NavigateUri="{Binding ProfileUrl}"
                                     Padding="0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    IsVisible="{Binding HasSummary}">
                <StackPanel Spacing="8">
                    <TextBlock Classes.rowLabel="True" Text="Обзор" />
                    <TextBlock Text="{Binding Summary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
