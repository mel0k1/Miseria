<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:Miseria.App.ViewModels"
        xmlns:views="using:Miseria.App.Views"
        x:Class="Miseria.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Miseria"
        Width="980"
        Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:FriendsViewModel">
            <views:FriendsView />
        </DataTemplate>
        <DataTemplate DataType="vm:LibraryViewModel">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="vm:DownloadViewModel">
            <views:DownloadsView />
        </DataTemplate>
        <DataTemplate DataType="vm:MarketViewModel">
            <views:MarketView />
        </DataTemplate>
        <DataTemplate DataType="vm:TradesViewModel">
            <views:TradesView />
        </DataTemplate>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfileViewModel">
            <views:ProfileView />
        </DataTemplate>
    </Window.DataTemplates>
    <ui:FANavigationView x:Name="Nav"
                         PaneDisplayMode="Left"
                         OpenPaneLength="220"
                         IsBackButtonVisible="False"
                         IsSettingsVisible="False"
                         IsPaneToggleButtonVisible="False"
                         SelectionChanged="OnNavSelectionChanged">
        <ui:FANavigationView.MenuItems>
            <ui:FANavigationViewItem Tag="friends" Content="Друзья">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="People" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Tag="library" Content="Библиотека">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Games" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Tag="downloads" Content="Загрузки">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Download" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Tag="market" Content="Маркет">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Shop" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Tag="trades" Content="Обмены">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Tag" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Tag="home" Content="Главная">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Home" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Tag="profile" Content="Профиль">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Account" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Tag="settings" Content="Настройки">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Settings" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
        </ui:FANavigationView.MenuItems>
        <ui:FANavigationView.PaneFooter>
            <StackPanel Margin="12,8,12,12"
                        Spacing="2">
                <TextBlock Text="{Binding Home.Account.AccountName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Home.SteamIdText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:FANavigationView.PaneFooter>
        <ContentControl Content="{Binding CurrentPage}" />
    </ui:FANavigationView>
</Window>
